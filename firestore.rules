rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in ['naveencodes247@gmail.com', 'outfyt.co.in@gmail.com'];
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Outfit
    function isValidOutfit(data) {
      return data.keys().hasAll(['id', 'slug', 'title', 'description', 'category', 'tags', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'title', 'description', 'category', 'tags', 'heroImageUrl', 'heroMediaType', 'heroMediaUrl', 'heroThumbnailUrl', 'heroMediaAlt', 'status', 'createdAt', 'updatedAt', 'publishedAt'])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 32 && data.id.matches('^OUT-[0-9]{3,}$')
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$')
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 50
        && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)
        && (data.heroImageUrl == null || (data.heroImageUrl is string && data.heroImageUrl.size() <= 2048))
        && (data.heroMediaUrl == null || (data.heroMediaUrl is string && data.heroMediaUrl.size() <= 2048))
        && (data.heroMediaType == null || data.heroMediaType in ['image', 'video'])
        && (data.heroThumbnailUrl == null || (data.heroThumbnailUrl is string && data.heroThumbnailUrl.size() <= 2048))
        && (data.heroMediaAlt == null || (data.heroMediaAlt is string && data.heroMediaAlt.size() <= 200))
        && data.status in ['draft', 'published', 'archived']
        && (data.publishedAt == null || data.publishedAt is timestamp);
    }

    // Validation helper for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['outfitId', 'name', 'retailer', 'currency', 'affiliateUrl', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['outfitId', 'name', 'retailer', 'category', 'retailerLogoUrl', 'price', 'currency', 'affiliateUrl', 'imageUrl', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.outfitId is string && data.outfitId.size() >= 4 && data.outfitId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && data.retailer is string && data.retailer.size() >= 2 && data.retailer.size() <= 80
        && (data.category == null || (data.category is string && data.category.size() <= 50))
        && (data.retailerLogoUrl == null || (data.retailerLogoUrl is string && data.retailerLogoUrl.size() <= 1000))
        && (data.price == null || data.price is number)
        && data.currency is string && data.currency.size() == 3
        && data.affiliateUrl is string && data.affiliateUrl.size() <= 2048
        && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && data.sortOrder is number;
    }

    // Validation helper for ClickEvent
    function isValidClickEvent(data) {
      return data.keys().hasAll(['outfitId', 'productId', 'retailer', 'clickedAt'])
        && data.keys().hasOnly(['outfitId', 'productId', 'retailer', 'clickedAt'])
        && data.outfitId is string && data.outfitId.size() <= 64
        && data.productId is string && data.productId.size() <= 64
        && data.retailer is string && data.retailer.size() <= 80;
    }

    // Validation helper for Admin
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 120
        && data.role in ['super_admin', 'editor'];
    }

    // Validation helper for Category
    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'group', 'description', 'tagline', 'accent', 'imageUrl', 'isCustom', 'archived', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && (data.group == null || (data.group is string && data.group.size() <= 40))
        && (data.description == null || (data.description is string && data.description.size() <= 1000))
        && (data.tagline == null || (data.tagline is string && data.tagline.size() <= 200))
        && (data.accent == null || (data.accent is string && data.accent.size() <= 100))
        && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (data.isCustom == null || data.isCustom is bool)
        && (data.archived == null || data.archived is bool);
    }

    // ----------------------------------------------------
    // Collection: outfits
    // ----------------------------------------------------
    match /outfits/{outfitId} {
      // Single-document read
      allow get: if isValidId(outfitId) && (resource.data.status == 'published' || isAdmin());

      // Query / list: public can only query published outfits; admin can list all
      allow list: if (resource.data.status == 'published') || isAdmin();

      // Create: Verified Admin only
      allow create: if isValidId(outfitId)
        && isAdmin()
        && isValidOutfit(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Update: Verified Admin only with immutable id and createdAt
      allow update: if isValidId(outfitId)
        && isAdmin()
        && isValidOutfit(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      // Delete: Verified Admin only
      allow delete: if isValidId(outfitId) && isAdmin();
    }

    // ----------------------------------------------------
    // Collection: products
    // ----------------------------------------------------
    match /products/{productId} {
      // Public visitors can view individual product documents
      allow get: if isValidId(productId);

      // Query / list products for public display (writes strictly restricted to admin)
      allow list: if true;

      // Create: Admin only, parent outfit must exist
      allow create: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && exists(/databases/$(database)/documents/outfits/$(incoming().outfitId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Update: Admin only, immutable parent reference and createdAt
      allow update: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().outfitId == existing().outfitId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      // Delete: Admin only
      allow delete: if isValidId(productId) && isAdmin();
    }

    // ----------------------------------------------------
    // Collection: clickEvents
    // ----------------------------------------------------
    match /clickEvents/{clickEventId} {
      // Append-only click recording from visitors
      allow create: if isValidId(clickEventId)
        && isValidClickEvent(incoming())
        && incoming().clickedAt == request.time
        && exists(/databases/$(database)/documents/outfits/$(incoming().outfitId));

      // Telemetry read and list restricted strictly to admins
      allow get: if isValidId(clickEventId) && isAdmin();
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isValidId(clickEventId) && isAdmin();
    }

    // ----------------------------------------------------
    // Collection: admins
    // ----------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // ----------------------------------------------------
    // Collection: categories
    // ----------------------------------------------------
    match /categories/{categoryId} {
      // Public visitors can list and read categories
      allow get, list: if true;

      // Creation, update and removal strictly restricted to verified OutFyt administrators
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(categoryId) && isAdmin();
    }
  }
}
