# OutFyt.co.in Environment Variables
# Copy this file to .env.local for local development.

# Supabase Storage Configuration (Outfit media uploads)
# NOTE: Only use public publishable/anon keys in VITE_SUPABASE_ANON_KEY.
# Never expose service-role or secret keys in frontend builds.
VITE_SUPABASE_URL="https://mkznvbwpdtxubjwggtfm.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"
VITE_SUPABASE_STORAGE_BUCKET="outfit-media"


